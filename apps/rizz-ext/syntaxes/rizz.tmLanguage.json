{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RizzScript",
  "scopeName": "source.rizz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rizz",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rizz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rizz",
          "match": "\\b(Maybe|Unless|Crazy|Attempt|Eww|HawkTuah|Vibe|Chill)\\b"
        },
        {
          "name": "keyword.control.js.rizz",
          "match": "\\b(if|else|for|while|try|catch|finally|async|await)\\b"
        },
        {
          "name": "storage.type.rizz",
          "match": "\\b(Ayo|Yoo|let|const)\\b"
        },
        {
          "name": "keyword.other.rizz",
          "match": "\\b(Bruh|function)\\b"
        },
        {
          "name": "keyword.control.flow.rizz",
          "match": "\\b(Rizz|return|Cringe|throw)\\b"
        },
        {
          "name": "support.function.builtin.http.rizz",
          "match": "\\b(Spit|Yeet|Flex|Ghost)\\b"
        },
        {
          "name": "support.function.builtin.tcp.rizz",
          "match": "\\b(Listen|Holla|Peek|Whisper|Dip)\\b"
        },
        {
          "name": "support.function.builtin.io.rizz",
          "match": "\\b(Snag|Stash|KeepAdding|Trash|FileExists)\\b"
        },
        {
          "name": "support.function.builtin.json.rizz",
          "match": "\\b(Decode|Encode)\\b"
        },
        {
          "name": "support.function.builtin.regex.rizz",
          "match": "\\b(Hunt|Swap|Matches|Split)\\b"
        },
        {
          "name": "keyword.import.rizz",
          "match": "\\b(Bring|import|export|from)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rizz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rizz",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.rizz",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.rizz",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.regexp.rizz",
          "begin": "r\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rizz",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rizz",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.rizz",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.rizz",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.rizz",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.rizz",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.assignment.rizz",
          "match": "="
        },
        {
          "name": "keyword.operator.range.rizz",
          "match": "\\.\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rizz",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rizz",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    }
  }
}
