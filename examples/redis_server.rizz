Yoo PORT = 6380
Yoo CRLF = "\x0d\x0a"

// In-memory store (HashMap datatype)
Ayo STORE = HashMap()

// RESP protocol helper: bulk string
Bruh bulkString(str) {
  Maybe str == null {
    Rizz("$-1" + CRLF)  // Null bulk string
  }
  Ayo s = str + ""  // Convert to string
  Ayo len = Len(s)
  Rizz("$" + len + CRLF + s + CRLF)
}

// RESP protocol helper: simple string
Bruh simpleString(str) {
  Rizz("+" + str + CRLF)
}

// RESP protocol helper: error
Bruh errorString(str : string) {
  Rizz("-" + str + CRLF)
}

// RESP protocol helper: integer
Bruh intString(num) {
  Rizz(":" + num + CRLF)
}

// Parse RESP array format from redis-cli
// Format: *<count>\r\n$<len>\r\n<data>\r\n$<len>\r\n<data>\r\n...
Bruh parseRESP(msg) {
  Ayo result = []
  
  // Extract bulk strings using regex
  // Pattern: $<number>\r\n<data> - we want to capture <data>
  Ayo pattern = r"\$\d+\r\n([^\r\n]+)"
  Ayo matches = Hunt(msg, pattern)
  
  Maybe Len(matches) > 0 {
    // Extract the captured groups (the actual data)
    Crazy match in matches {
      result = result + [match]
    }
  } Unless {
    // Fallback: try plain text parsing if no RESP format found
    Ayo trimmed = Trim(msg)
    Maybe Len(trimmed) > 0 {
      result = Split(trimmed, r"\s+")
    }
  }
  
  Rizz(result)
}

Bruh handleClient(sock) HawkTuah {
  Attempt {
    Ayo msg = Peek(sock)
    Ayo parts = parseRESP(msg)

    Maybe Len(parts) == 0 {
      let errStr = "ERR empty command"
      Whisper(sock, errorString(errStr))
      Dip(sock)
      Rizz(null)
    }

    Ayo cmd = parts[0]

    Maybe cmd == "GET" && Len(parts) >= 2 {
      Ayo key = parts[1]
      Ayo val = HGet(STORE, key)
      Whisper(sock, bulkString(val))
    } Unless Maybe cmd == "SET" && Len(parts) >= 3 {
      Ayo key = parts[1]
      Ayo value = parts[2]
      HSet(STORE, key, value)
      Whisper(sock, simpleString("OK"))
    } Unless Maybe cmd == "DEL" && Len(parts) >= 2 {
      Ayo key = parts[1]
      Ayo ok = HDel(STORE, key)
      Whisper(sock, intString(Maybe ok ? 1 : 0))
    } Unless Maybe cmd == "PING" {
      Whisper(sock, simpleString("PONG"))
    } Unless Maybe cmd == "COMMAND" {
      // redis-cli sends COMMAND DOCS on connect - just return empty array
      Whisper(sock, "*0" + CRLF)
    } Unless {
      Whisper(sock, errorString("ERR unknown command '" + cmd + "'"))
    }

    // Close connection gracefully
    Dip(sock)
  } Eww (error) {
    Rizz("Error handling client: " + error)
    Attempt {
      Whisper(sock, errorString("ERR server error: " + error))
      Dip(sock)
    } Eww (e2) {
      Rizz("Failed to send error: " + e2)
    }
  }
  
  Rizz(null)
}

Bruh main() HawkTuah {
  Rizz("Redis-ish TCP server on " + PORT)
  Ayo server = Listen(PORT, handleClient)
  Chill(server)
}

Vibe main()

